{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCMemory",
  "version": "0.1.0",
  "identifier": "com.vrcmemory.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "VRCMemory",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' asset: https://asset.localhost; img-src 'self' asset: https://asset.localhost data:; connect-src 'self' http://127.0.0.1:8765 https://github.com https://api.github.com; font-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "resources": {
      "../python-sidecar/": "python-sidecar/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "VRChat写真管理 & AI検索",
    "longDescription": "VRChatの思い出をAIで整理し、雑な言葉で見つけ出せるデスクトップアプリ。写真管理、ワールド訪問履歴、フレンド分析を一つに。",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["Japanese", "English"],
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/Kamitya764/VRCMemory/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5M0RENENEQkMwQjAyMkQKUldRdEFndTh6ZFE5R1JsVlZtT0t2TUxsSkVGL1l4TTgrZG5mTTNzYi9rMzlJT1lhcjc1cnJZZGoK"
    }
  }
}
